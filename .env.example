# Food Waste Redistribution Network — Environment Configuration Example
# Copy this file to backend/.env and replace the values with your local settings.

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=food_waste_db

# SSL Configuration (set to true for local MySQL without TLS certificates)
DB_SSL_DISABLED=true

# Optional SSL Certificate paths (for managed cloud databases e.g. Aiven)
# DB_SSL_CA=
# DB_SSL_CERT=
# DB_SSL_KEY=

# Flask Secret Key for Session Signing
SECRET_KEY=your_secret_key_here_generate_with_python_secrets
